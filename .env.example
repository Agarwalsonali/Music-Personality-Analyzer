# Spotify OAuth PKCE Configuration

# Get these values from https://developer.spotify.com/dashboard

# Public - used in browser
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Server-side only - NEVER expose to client
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Set to true to use mock user/tracks for the analyzer (no Spotify Premium needed)
NEXT_PUBLIC_USE_MOCK_DATA=true
